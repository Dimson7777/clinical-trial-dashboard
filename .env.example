# Application Settings
APP_NAME="Clinical Trial Dashboard API"
LOG_LEVEL=INFO

# Database Connection (SQLite default for local challenge; PostgreSQL supported for production)
DATABASE_URL="sqlite:///./clinical_trial.db"

# Security & Authentication
SECRET_KEY="generate-a-strong-random-secret-key-for-production"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Allowed CORS Origins (comma-separated)
CORS_ORIGINS="http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:5173"

# Seed Demo User Credentials
DEMO_USER_EMAIL="researcher@trial.dev"
DEMO_USER_PASSWORD="Demo1234!"
